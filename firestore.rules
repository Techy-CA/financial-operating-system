rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ─────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── COMPANY USERS ─────────────────────────────────────
    match /companyUsers/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── WORKSPACE KEYS ────────────────────────────────────
    match /workspaceKeys/{docId} {
      allow read:   if true; // Anyone can verify a key (read-only, no sensitive data)
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // ── JOIN REQUESTS ─────────────────────────────────────
    match /joinRequests/{docId} {
      allow read, write: if request.auth != null;
      allow create:      if true; // Allow unauthenticated join requests (after account created)
    }

    // ── INVITES ───────────────────────────────────────────
    match /invites/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── COMPANIES ─────────────────────────────────────────
    match /companies/{companyId} {
      // Company profile: public read for invoice sharing (name, logo, bank details)
      allow read: if true;
      allow write: if request.auth != null;

      // Subcollections
      match /{subcol}/{docId} {
        // invoices + invoiceItems: PUBLIC READ so invoice links work without login
        allow read:  if true;
        allow write: if request.auth != null;
      }

      match /{subcol}/{docId}/{nested=**} {
        allow read:  if true;
        allow write: if request.auth != null;
      }
    }
  }
}
